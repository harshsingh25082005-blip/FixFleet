<body>
    <style>
body, .container, #A1, #B3, #C5, #C6, #C7, #D7, #D8 {
    margin: 0;
    padding: 0;
}
        body {
            overflow-y: scroll;
        }

        .container {
            display: grid;
            grid-template-columns: auto 1fr auto auto auto;
            grid-template-rows: auto 1fr auto;
            min-height: 100vh;
        }

        #A1 {
            grid-column: 1;
            grid-row: 1 / -1;
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 0 10px;
            overflow: hidden;
            background: #edeff3;
            color: white;
        }

        #A1::after {
            content: "";
            position: absolute;
            top: 30px;
            right: 0;
            width: 1px;
            height: calc(100vh - 30px);
            background: #d4d8de;
        }

        #B3 {
            grid-column: 2 / 6;
            grid-row: 1;
            position: sticky;
            top: 0;
            height: 30px;
            padding: 0;
            z-index: 10;
            overflow: hidden;
            background: #edeff3;
            border-bottom: 1px solid #d4d8de;
        }

        #D7 {
            grid-column: 2;
            grid-row: 2;
            margin: 0;
            padding: 0;
            padding-left: 30px;
            line-height: 1.6;
        }

        #D8 {
            grid-column: 2;
            grid-row: 3;
            position: sticky;
            bottom: 0;
            z-index: 5;
            background: #fefefe;
        }

        #C5 {
            grid-column: 3;
            grid-row: 1 / -1;
            position: sticky;
            top: 40px;
            align-self: start;
            height: calc(98vh - 60px);
            overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
        }
        
        #C6 {
            grid-column: 4;
            grid-row: 1 / -1;
            position: sticky;
            top: 40px;
            align-self: start;
            height: calc(98vh - 60px);
            max-width: 200px;
            overflow: hidden;
            margin: 0 10px;
            padding: 8px 5px;
    display: flex;
    flex-direction: column;
    justify-content: center;
        }
        
        #C7 {
            grid-column: 5;
            grid-row: 1 / -1;
            position: sticky;
            top: 40px;
            align-self: start;
            height: calc(98vh - 60px);
            margin: 0 20px 0 0;
            overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
        }
        
 #toc {
 z-index:15;
 overflow-x: hidden;
 overflow-y: auto;
 background: #f6f8fa;
 border-width: 2px;
 border-style: groove;
 border-radius: 3px;
 border-color: #e1e4e8;
 margin: 0 5px;
 padding: 0;
 max-height: 100%;
}

#toc ul {
margin: 0;
list-style-type: none;
padding: 0;
}

#toc li {
    padding:0 10px;
    margin: 0;
}

#toc li a {
    padding:5px 0;
display: inline-block;
text-decoration:none;
width:100%;
color: #5e6d7d;
}

#toc li a:hover {
color: #0366d6;
}

#toc li:hover {
background: #fefefe;
}

        #magic {
            position: absolute;
            top: 0;
            right: 50px;
            width: 30px;
            height: 30px;
            overflow: hidden;
            background: #edeff3;
            z-index: 14;
        }

        #magic:hover {
            width: calc(100% - 50px);
        }

        #magic .menu1 {
            position: absolute;
            top: 0;
            right: 30px;
            height: 30px;
            padding-left: 10px;
            background: #edeff3;
            border-left: 1px solid #d4d8de;
            border-bottom: 1px solid #d4d8de;
        }

        #magic > img {
            position: absolute;
            top: 0;
            right: 0;
            width: 30px;
            height: 30px;
            filter: brightness(0) saturate(100%) invert(42%) sepia(22%) saturate(385%) hue-rotate(170deg) brightness(92%) contrast(84%);
        }

        #magic:hover > img {
